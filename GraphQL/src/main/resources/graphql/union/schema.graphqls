
type Query {
    search: [Result]
}

# Sử dụng union để định nghĩa kiểu trả về có thể là nhiều loại khác nhau kết hợp mà không cần chung một trường nào cả
union Result = Fruit | Electronics | Book


type Fruit {
    description: String
    expiryDate: String
}

type Electronics {
    id: ID!
    description: String
    price: Int
    brand: Brand
}

enum Brand {
    APPLE
    SAMSUNG
}

type Book {
    title: String
    author: String
}
